// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PartnerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PartnerType {
  RESELLER
  INTEGRATOR
  OTHER
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
}

enum BundleStatus {
  PENDING
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum SlabStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

model Company {
  id        Int           @id @default(autoincrement())
  name      String
  legalName String?
  document  String?       @unique
  email     String?
  phone     String?
  status    CompanyStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  materials               Material[]
  bundles                 Bundle[]
  qualities               Quality[]
  finishes                Finish[]
  materialTypes           MaterialType[]
  materialClassifications MaterialClassification[]

  memberships CompanyMembership[]
  roles       Role[]

  partners PartnerCompany[]
  partner  Partner?

  @@index([status])
  @@index([deletedAt])
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  memberships   CompanyMembership[]
  refreshTokens RefreshToken[]

  /// createdShares             Share[]              @relation("ShareCreatedBy")
  /// assignedReservationRequests ReservationRequest[] @relation("ReservationAssignedTo")
  /// approvedReservations      Reservation[]        @relation("ReservationApprovedBy")
  /// reservationStatusHistory  ReservationStatusHistory[]
  /// notifications             NotificationRecipient[]
  /// auditEvents               AuditEvent[]

  @@index([status])
  @@index([deletedAt])
}

model CompanyMembership {
  id Int @id @default(autoincrement())

  userId    Int
  companyId Int
  status    MembershipStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roles UserRole[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isSystem])
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  id Int @id @default(autoincrement())

  membershipId Int
  roleId       Int

  createdAt DateTime @default(now())

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId       Int
  permissionId Int

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Partner {
  id Int @id @default(autoincrement())

  companyId Int? @unique

  name   String
  type   PartnerType
  email  String?
  phone  String?
  status PartnerStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company?         @relation(fields: [companyId], references: [id])
  companies PartnerCompany[]

  @@index([type])
  @@index([status])
  @@index([deletedAt])
}

model PartnerCompany {
  id Int @id @default(autoincrement())

  partnerId Int
  companyId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([partnerId, companyId])
  @@index([companyId])
}

model RefreshToken {
  id Int @id @default(autoincrement())

  userId    Int
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Material {
  id        Int @id @default(autoincrement())
  companyId Int

  name        String
  description String?

  status MaterialStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  bundles Bundle[]

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model Bundle {
  id         Int @id @default(autoincrement())
  companyId  Int
  materialId Int

  materialTypeId           Int
  materialClassificationId Int
  qualityId                Int
  finishId                 Int

  bundleCode String
  block      String?
  location   String?

  thickness Decimal?
  weight    Decimal?

  basePrice Decimal?

  status BundleStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  materialType           MaterialType           @relation(fields: [materialTypeId], references: [id], onDelete: Restrict)
  materialClassification MaterialClassification @relation(fields: [materialClassificationId], references: [id], onDelete: Restrict)
  quality                Quality                @relation(fields: [qualityId], references: [id], onDelete: Restrict)
  finish                 Finish                 @relation(fields: [finishId], references: [id], onDelete: Restrict)

  images BundleImage[]
  slabs Slab[]

  @@unique([companyId, bundleCode])
  @@index([companyId])
  @@index([materialId])
  @@index([materialTypeId])
  @@index([materialClassificationId])
  @@index([qualityId])
  @@index([finishId])
  @@index([status])
  @@index([deletedAt])
}

model BundleImage {
  id Int @id @default(autoincrement())

  bundleId Int @unique

  storageKey   String
  originalName String
  mimeType     String
  size         Int

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

model Slab {
  id Int @id @default(autoincrement())

  bundleId Int
  number   Int

  length Decimal?
  height Decimal?
  area   Decimal?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  status SlabStatus @default(AVAILABLE)

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  images SlabImage[]

  @@unique([bundleId, number])
  @@index([bundleId])
  @@index([status])
  @@index([deletedAt])
}

model SlabImage {
  id Int @id @default(autoincrement())

  slabId Int @unique

  storageKey   String
  originalName String
  mimeType     String
  size         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slab Slab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  @@index([slabId])
}

model Quality {
  id Int @id @default(autoincrement())

  companyId Int?

  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundles Bundle[]

  @@index([companyId])
  @@index([deletedAt])
}

model Finish {
  id Int @id @default(autoincrement())

  companyId Int?

  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundles Bundle[]

  @@index([companyId])
  @@index([deletedAt])
}

model MaterialType {
  id Int @id @default(autoincrement())

  companyId Int?
  name      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundles Bundle[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}

model MaterialClassification {
  id Int @id @default(autoincrement())

  companyId Int?
  name      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundles Bundle[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}
